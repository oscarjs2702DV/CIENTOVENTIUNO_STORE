{
  "name": "cientoventiuno-store",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Dominio propio de la tienda; www y workers.dev redirigen aquí (worker/index.js).
  "routes": [
    { "pattern": "cientoventiuno.com.de", "custom_domain": true },
    { "pattern": "www.cientoventiuno.com.de", "custom_domain": true }
  ],
  // Llave pública de Wompi (no es secreta). pub_test_ = pruebas; cambiar por pub_prod_ al salir en vivo.
  // Secretos en el panel: WOMPI_INTEGRITY_SECRET y WOMPI_EVENTS_SECRET.
  "vars": { "WOMPI_PUBLIC_KEY": "pub_prod_4nWFezuwaivH6aCHHLnK7sEdrJHbGccS" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Todo pasa por el Worker para poder redirigir la dirección antigua al dominio.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cientoventiuno-db",
      "database_id": "07656364-4dc0-4340-9f4d-de2a5b1b06a3"
    }
  ],
  "kv_namespaces": [
    { "binding": "FOTOS", "id": "5d081128e32d4549b837a80151aee932" }
  ],
  // Las vistas previas de ramas usan los mismos datos que la tienda.
  "previews": {
    "vars": { "WOMPI_PUBLIC_KEY": "pub_test_sTyn7J7SP28oVTHSV1XOp2nw6boIejT2" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "cientoventiuno-db",
        "database_id": "07656364-4dc0-4340-9f4d-de2a5b1b06a3"
      }
    ],
    "kv_namespaces": [
      { "binding": "FOTOS", "id": "5d081128e32d4549b837a80151aee932" }
    ],
    "ratelimits": [
      { "name": "CUSTOMER_LIMIT", "namespace_id": "1212", "simple": { "limit": 10, "period": 60 } }
    ]
  },
  // Intentos de acceso por minuto y dirección IP: 5 para el administrador y
  // 10 para clientes. Los secretos (ADMIN_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // y para el correo de bienvenida RESEND_API_KEY y MAIL_FROM) se configuran en el panel de Cloudflare, nunca aquí.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1210", "simple": { "limit": 5, "period": 60 } },
    { "name": "CUSTOMER_LIMIT", "namespace_id": "1211", "simple": { "limit": 10, "period": 60 } }
  ]
}
